                  "const b = pm.response.json();",
                  "pm.test(\"Новий запис\", () => { pm.expect(b.data.id).to.be.a(\"number\").above(0); pm.expect(b.data.title).to.equal(\"Перевірити POST\"); pm.expect(b.data.done).to.equal(false); });",
                  "if (pm.response.code === 201 && Number.isInteger(b.data.id)) { pm.environment.set(\"task_id\", b.data.id); }"
                ]
              }
            }
          ],
          "response": []
