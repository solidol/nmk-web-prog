    {
      "name": "02 — Ручне завантаження файла",
      "item": [
        {
          "name": "Вручну — Вкладення attachment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}?resource=echo",
              "host": [
