                  "value": "echo"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Студент DEMO",
                  "type": "text"
                },
                {
                  "key": "attachment",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "description": "Перед Send оберіть src/sample.txt у полі attachment. Не включайте цей запит у перший автоматичний запуск."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON MIME\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "pm.test(\"Метадані файла\", () => pm.expect(pm.response.json().data.file.size).to.be.above(0));"
                ]
