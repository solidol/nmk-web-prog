      "item": [
        {
          "name": "01 — Список завдань",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}?resource=tasks",
              "host": [
                "{{base_url}}"
              ],
              "query": [
                {
                  "key": "resource",
                  "value": "tasks"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"JSON MIME\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
                  "const b = pm.response.json();",
                  "pm.test(\"Два початкові записи\", () => { pm.expect(b.data).to.be.an(\"array\").with.lengthOf(2); pm.expect(b.meta.count).to.equal(2); });"
                ]
              }
            }
          ],
          "response": []
        },
